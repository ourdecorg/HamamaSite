---
import '../styles/global.css';
const { t } = Astro.props;
const p = t.privacy;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang={t.meta.lang} dir={t.meta.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{p.title} — {t.nav.brand}</title>
  <meta name="description" content={p.intro} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&family=Inter:wght@400;600;700&family=Vollkorn:wght@500;600&family=Assistant:wght@400;500;600;700&family=Frank+Ruhl+Libre:wght@500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <main class="privacy">
    <a class="brand" href={base + p.home}>{t.nav.brand}</a>
    <h1>{p.page_title}</h1>
    <p class="privacy-intro">{p.intro}</p>
    <ul class="privacy-list">
      {p.items.map((i) => <li><strong>{i.label}:</strong> {i.text}</li>)}
    </ul>
    <a class="text-link" href={base + p.home}>{p.back}</a>
  </main>
</body>
</html>
