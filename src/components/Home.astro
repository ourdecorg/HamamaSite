---
import '../styles/global.css';
const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (i) => String(i + 1).padStart(2, '0');
// Resolve site-internal absolute paths ("/en/") against the deploy base; leave anchors/external links alone.
const href = (h) => (h.startsWith('/') ? base + h : h);
const ext = (h) => (h.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
const other = t.meta.lang === 'he' ? 'en' : 'he';
---
<!doctype html>
<html lang={t.meta.lang} dir={t.meta.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.meta.title}</title>
  <meta name="description" content={t.meta.description} />
  <meta property="og:title" content={t.meta.title} />
  <meta property="og:description" content={t.meta.description} />
  <link rel="alternate" hreflang="he" href="https://hamama.org/" />
  <link rel="alternate" hreflang="en" href="https://hamama.org/en/" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&family=Inter:wght@400;600;700&family=Vollkorn:wght@500;600&family=Assistant:wght@400;500;600;700&family=Frank+Ruhl+Libre:wght@500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <main>
    <section class="hero">
      <header class="nav">
        <a class="brand" href="#">{t.nav.brand}</a>
        <nav class="nav-links" aria-label="Main">
          {t.nav.items.map((i) => <a class:list={{ strong: i.href.startsWith('http') }} href={href(i.href)} {...ext(i.href)}>{i.label}</a>)}
          <a class="lang" href={href(t.nav.switch.href)} hreflang={other} lang={other}>{t.nav.switch.label}</a>
        </nav>
      </header>
      <div class="hero-text">
        <h1>{t.hero.title}</h1>
        <p class="tagline">{t.hero.tagline}</p>
        <p class="hero-intro">{t.hero.intro}</p>
        <div class="hero-btns">
          <a class="btn btn-primary" href={href(t.hero.primary.href)}>{t.hero.primary.label}</a>
          <a class="btn btn-light" href={href(t.hero.secondary.href)}>{t.hero.secondary.label}</a>
        </div>
      </div>
      <div class="dots" aria-hidden="true" dir="ltr">
        <span class="dot d-mint"></span><span class="rule"></span><span class="dot d-big"></span><span class="rule"></span><span class="dot d-orange"></span>
      </div>
      <div class="portal-strip">
        <div class="portal-strip-text">
          <p class="eyebrow">{t.portal_card.label}</p>
          <p>{t.portal_card.text}</p>
        </div>
        <a class="btn btn-primary btn-43" href={t.portal_card.cta.href} {...ext(t.portal_card.cta.href)}>{t.portal_card.cta.label}</a>
      </div>
    </section>

    <section class="why">
      <h2>{t.why.title}</h2>
      <p class="intro">{t.why.intro}</p>
      <div class="why-grid">
        {t.why.questions.map((q, i) => (
          <div class="why-card"><p class="num">{pad(i)}</p><h3>{q}</h3></div>
        ))}
      </div>
    </section>

    <section class="what" id="what">
      <h2>{t.what.title}</h2>
      <p class="intro">{t.what.intro}</p>
      <div class="what-grid">
        {t.what.items.map((it) => (
          <div class="what-card"><h3>{it.title}</h3><p>{it.text}</p></div>
        ))}
      </div>
    </section>

    <section class="focus" id="focus">
      <h2>{t.focus.title}</h2>
      <div class="portal-card">
        <div class="portal-head"><h3>{t.focus.portal.title}</h3><span class="portal-dot" aria-hidden="true"></span></div>
        <p class="portal-sub">{t.focus.portal.subtitle}</p>
        <p class="portal-text">{t.focus.portal.text}</p>
        <div class="graph" aria-hidden="true" dir="ltr">
          <span class="edge e1"></span><span class="edge e2"></span>
          <span class="node n1"></span><span class="node n2"></span><span class="node n3"></span>
          <span class="edge e3 wide-only"></span><span class="edge e4 wide-only"></span><span class="edge e5 wide-only"></span>
          <span class="node n4"></span><span class="node n5"></span><span class="node n6"></span>
        </div>
        <a class="btn btn-portal" href={t.focus.portal.cta.href} {...ext(t.focus.portal.cta.href)}>{t.focus.portal.cta.label}</a>
      </div>
      <div class="focus-grid">
        {t.focus.cards.map((c, i) => (
          <div class:list={['focus-card', `fc${i + 1}`]}>
            <h3>{c.title}</h3>
            <p class="fc-sub">{c.subtitle}</p>
            <p class="fc-text">{c.text}</p>
            {c.cta && <a class="btn btn-soft" href={c.cta.href} {...ext(c.cta.href)}>{c.cta.label}</a>}
          </div>
        ))}
      </div>
    </section>

    <section class="work" id="work">
      <h2>{t.work.title}</h2>
      <p class="intro">{t.work.intro}</p>
      <div class="work-grid">
        {t.work.items.map((it) => (
          <div class="work-card"><h3>{it.title}</h3><p>{it.text}</p></div>
        ))}
      </div>
    </section>

    <section class="book" id="human-fabric">
      <div class="book-text">
        <p class="eyebrow">{t.book.eyebrow}</p>
        <h2>{t.book.title}</h2>
        <p class="book-sub">{t.book.subtitle}</p>
        <p class="book-body">{t.book.body}</p>
        <div class="invite"><p>{t.book.invite}</p></div>
        <div class="book-btns">
          <a class="btn btn-deep" href={t.book.read.href} target="_blank" rel="noopener">{t.book.read.label}</a>
          <a class="text-link" href={t.book.talk.href}>{t.book.talk.label}</a>
        </div>
      </div>
      <div class="book-side">
        <div class="cover" dir="ltr" lang="en">
          <div class="cover-lines" aria-hidden="true"><span></span><span></span><span></span></div>
          <div>
            <h3>{t.book.cover_title}</h3>
            <p>{t.book.cover_subtitle}</p>
          </div>
        </div>
        <blockquote class="quote"><p>{t.book.quote}</p></blockquote>
      </div>
    </section>

    <section class="connect" id="connect">
      <h2>{t.connect.title}</h2>
      <p class="intro">{t.connect.text}</p>
      <a class="btn btn-glass" href={`mailto:${t.connect.email}`}>{t.connect.email}</a>
      <p class="closing">{t.connect.closing}</p>
    </section>
  </main>
</body>
</html>
